# Build consultable via XAMPP (Apache) : npm run build:xampp
# Puis ouvrir http://localhost/dashboard/Reyel16Paryaj/Reyel16Paryaj/frontend/dist/
#
# Si votre dépôt est ailleurs dans htdocs, créez .env.xampp.local (non versionné) avec votre propre VITE_BASE.
VITE_BASE=/dashboard/Reyel16Paryaj/Reyel16Paryaj/frontend/dist/

# L'API Laravel tourne à part (PHP 8.3 requis) : php artisan serve dans backend/.
VITE_API_URL=http://localhost:8000/api/v1
