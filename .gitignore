# Les sous-projets ont leurs propres .gitignore (backend/, frontend/).

# Secrets
.env
.env.*
!.env.example
# Mode de build XAMPP du frontend : chemin et URL locale, aucun secret (surcharges perso : .env.xampp.local).
!frontend/.env.xampp
auth.json

# Dépendances / builds
vendor/
node_modules/
dist/

# Logs
*.log

# IDE / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Fichiers temporaires Office
~$*
