APP_NAME="REYEL 16 PARYAJ"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=reyel16
DB_USERNAME=reyel16
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Durée maximale d'une session depuis la connexion, même active (V2-C06) ; MFA redemandé à un admin inactif.
IDENTITY_PLAYER_SESSION_MAX_MINUTES=720
IDENTITY_ADMIN_SESSION_MAX_MINUTES=480
IDENTITY_ADMIN_MFA_IDLE_MINUTES=30
# Paris placés au plus par minute et par joueur (V2-C06).
BETTING_MAX_BETS_PER_MINUTE=10
# Paris en direct (D-20) : coupe-circuit (false = coupés, par défaut), délai d'acceptation (5 à 15 s) et délai maximal
# avant refus, tolérance sur la cote qui bouge (0.03 = 3 %), mise maximale d'un ticket en direct, combinés en direct
BETTING_ALLOW_LIVE=false
BETTING_LIVE_ACCEPTANCE_DELAY=8
BETTING_LIVE_ACCEPTANCE_TIMEOUT=60
BETTING_LIVE_ODDS_TOLERANCE=0.03
BETTING_LIVE_MAX_STAKE_MINOR=1000000
BETTING_LIVE_ALLOW_MULTIPLE=false
# Requêtes par minute d'un compte connecté sur toute l'API, par compte et non par IP (revue P8-02, F12).
API_ACCOUNT_RATE_PER_MINUTE=120
# Requêtes par minute d'un visiteur non connecté sur toute l'API, par IP (D-17, PS-5) ; 0 = sans limite (urgence).
# Derrière Cloudflare, régler TRUSTED_PROXIES d'abord : sinon tous les visiteurs semblent venir de quelques IP.
IDENTITY_API_GUEST_RATE_PER_MINUTE=300
# Vérification anti-robot Cloudflare Turnstile (D-17) : inscription, mot de passe oublié, connexion après 3 échecs.
# Vide = désactivée. Ne la renseigner qu'une fois le widget présent dans les écrans (#193). Clés de test de Cloudflare
# pour le Staging : https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=
# Domaines acceptés pour le jeton, séparés par des virgules (ex. reyel16paryaj.com) ; vide = non vérifié.
TURNSTILE_ALLOWED_HOSTNAMES=
# Cookie de session HTTPS uniquement : vrai par défaut en production ; en local, selon la requête.
# SESSION_SECURE_COOKIE=true

# Reverse proxy devant l'API (staging / production) : IP ou CIDR, séparés par des virgules. Jamais "*".
# TRUSTED_PROXIES=10.0.0.2

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend autorisé (CORS / Sanctum SPA)
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173
# Origines CORS autorisées (par défaut : FRONTEND_URL). Pour le build XAMPP servi par Apache, ajouter http://localhost
# et l'ajouter aussi à SANCTUM_STATEFUL_DOMAINS (ex. localhost:5173,localhost).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# Fournisseur de données sportives (P3-02) — ne jamais committer de vraie clé
# "fake" (développement, tests) ou "theodds" (The Odds API). Diagnostic sans coût : php artisan sports-data:check
SPORTS_DATA_PROVIDER=fake
SPORTS_DATA_API_URL=https://api.the-odds-api.com/v4
SPORTS_DATA_API_KEY=
# Sports synchronisés (clés du fournisseur), régions et marchés : coût d'un appel = marchés × régions
# "*" = toutes les compétitions actives du fournisseur (environ 70 : ~70 crédits par passage complet en 1X2 seul ;
# avec SPORTS_DATA_BUDGET=true elles sont rafraîchies à tour de rôle pour tenir dans le quota mensuel).
# Motifs possibles, mêlés aux clés exactes : "tennis_*" = tous les tournois de tennis en cours (une clé par tournoi).
# Une compétition retirée de la liste disparaît du catalogue à la synchro suivante (et y revient si elle est remise).
SPORTS_DATA_SPORTS=soccer_epl
SPORTS_DATA_REGIONS=eu
# Marchés : h2h (1X2) et totals (plus/moins, "Nombre de buts") — 2 marchés × 1 région = 2 crédits par compétition
SPORTS_DATA_MARKETS=h2h,totals
# Bookmaker de référence pour les cotes publiées (vide = tous ; décision P0-04)
SPORTS_DATA_REFERENCE_BOOKMAKER=
# Plus aucun appel payant sous ce nombre de requêtes restantes (réserve jamais dépensée par le budget)
SPORTS_DATA_MIN_REMAINING=25
# Budget de crédits : répartit les crédits restants sur les synchros d'ici la remise à zéro du quota
# (true/false), crédits de l'offre par mois, jour du mois de remise à zéro. Suivi : php artisan sports-data:credits
SPORTS_DATA_BUDGET=true
SPORTS_DATA_MONTHLY_CREDITS=500
SPORTS_DATA_QUOTA_RESET_DAY=1
# Synchronisation : fréquence (cron), horizon, nombre de matchs par compétition, âge max d'une cote (minutes)
SPORTS_DATA_SYNC_CRON="0 */4 * * *"
SPORTS_DATA_HORIZON_DAYS=7
SPORTS_DATA_MAX_EVENTS=10
SPORTS_DATA_MAX_ODDS_AGE=300
# Import des résultats : fréquence (cron) et délai après le début du match avant de demander le score (minutes)
SPORTS_DATA_RESULTS_CRON="20 * * * *"
SPORTS_DATA_RESULTS_DELAY=105
# Matchs en direct (onglet Live) : activation, fréquence (cron), durée pendant laquelle un match commencé est suivi
# (minutes), plafond de crédits par jour, âge max d'une cote en direct (minutes)
SPORTS_DATA_LIVE=true
SPORTS_DATA_LIVE_CRON="*/15 * * * *"
SPORTS_DATA_LIVE_WINDOW=180
SPORTS_DATA_LIVE_DAILY_CREDITS=30
SPORTS_DATA_MAX_LIVE_ODDS_AGE=20
# Modèle de cotes en direct (D-20, seulement si BETTING_ALLOW_LIVE=true) : score relu toutes les N secondes
# (10, 15, 20, 30 ou 60 ; 1 crédit par compétition de football pariable en direct), âge max du score (s), suspension après une
# action comme un but (s, levée d'elle-même), délai sans score avant de fermer le direct du match (s), dernière minute
# pariable, probabilité au-delà de laquelle le marché est suspendu, buts attendus par défaut
SPORTS_DATA_LIVE_SCORES_SECONDS=30
SPORTS_DATA_LIVE_MAX_SCORE_AGE=90
SPORTS_DATA_LIVE_ACTION_SUSPENSION_SECONDS=10
SPORTS_DATA_LIVE_SCORE_UNAVAILABLE_CLOSE_SECONDS=300
SPORTS_DATA_LIVE_CUTOFF_MINUTE=85
SPORTS_DATA_LIVE_MAX_PROBABILITY=0.95
SPORTS_DATA_LIVE_DEFAULT_GOALS=2.6
# Score exact final en direct : scores proposés jusqu'à N buts de plus par équipe que le score du moment, cote maximale
SPORTS_DATA_LIVE_CORRECT_SCORE_EXTRA_GOALS=3
SPORTS_DATA_LIVE_CORRECT_SCORE_MAX_ODDS=100
# Marchés du football chargés match par match (double chance, handicap, buts par équipe…) : 1 crédit par marché reçu
# ET par match. Activation, fréquence (cron), matchs qui commencent dans N heures, compétitions (vide = tout le football
# actif), plafond de crédits par jour (0 = sans plafond), marchés demandés
SPORTS_DATA_EXTRA=false
SPORTS_DATA_EXTRA_CRON="30 */3 * * *"
SPORTS_DATA_EXTRA_HOURS=72
SPORTS_DATA_EXTRA_COMPETITIONS=
SPORTS_DATA_EXTRA_DAILY_CREDITS=1000
SPORTS_DATA_EXTRA_MARKETS=double_chance,draw_no_bet,btts,correct_score,spreads,alternate_spreads,alternate_totals,team_totals,alternate_team_totals,odd_even,h2h_h1,double_chance_h1,draw_no_bet_h1,totals_h1,btts_h1,correct_score_h1,halftime_fulltime,alternate_totals_corners,alternate_spreads_corners,alternate_team_totals_corners,alternate_totals_cards,alternate_spreads_cards
# Statistiques des matchs terminés (V2-D09) pour régler 1re mi-temps, corners et cartons : apifootball (API-Football),
# vide = ces marchés ne sont pas proposés. Clé saisie sur le serveur (set-statistics-key.sh), jamais dans le dépôt.
# Fréquence, délai avant d'annuler un pari sans statistiques (h), écart toléré sur le coup d'envoi (min)
STATISTICS_PROVIDER=
STATISTICS_API_KEY=
STATISTICS_CRON="*/20 * * * *"
STATISTICS_VOID_AFTER_HOURS=48
STATISTICS_KICKOFF_TOLERANCE=20
# Marchés maison du football (V2-D10), seulement ceux que The Odds API ne fournit pas, cotés par REYEL 16 et réglés sur
# le score final : activation, bookmakers nécessaires sur le 1X2, marge (0.12 = 12 %), cote maximale, mise maximale
SPORTS_DATA_HOUSE_MARKETS=true
SPORTS_DATA_HOUSE_MARKETS_MIN_BOOKMAKERS=2
SPORTS_DATA_HOUSE_MARKETS_MARGIN=0.12
SPORTS_DATA_HOUSE_MARKETS_MAX_ODDS=100
SPORTS_DATA_HOUSE_MARKETS_MAX_STAKE_MINOR=100000
# Délai d'attente d'un appel (s) — un appel payant n'est jamais rejoué
SPORTS_DATA_TIMEOUT=30

# Borlette (module Lottery) — tirages et résultats publiés par un fournisseur externe ; ne jamais committer de vraie clé.
# LOTTERY_ENABLED=false : routes /lottery/* en 404 et aucune synchro planifiée. Synchro manuelle : php artisan lottery:sync
LOTTERY_ENABLED=false
# fake (développement) ou unitysoftconnect (API Borlette UnitySoftConnect, clé Bearer « usc_live_… »)
LOTTERY_PROVIDER=fake
LOTTERY_API_URL=https://unityscgroup.com/api/v1/borlette
LOTTERY_API_KEY=
LOTTERY_API_TIMEOUT=20
# Fréquence de la synchro (cron) et nombre de jours relus en arrière (rattrapage après une panne)
LOTTERY_SYNC_CRON="*/5 * * * *"
LOTTERY_RESULTS_DAYS_BACK=1

# Devise par défaut (décision Phase 0)
APP_CURRENCY=HTG
# Crédit offert à l'inscription, en unité mineure (500000 = 5 000,00 HTG) ; 0 = aucun crédit (défaut)
WALLET_WELCOME_CREDIT_MINOR=0
# Fonds fictifs (V1). false dès que l'argent est réel (dépôts par Plop Plop, V2-B04) : plus aucun crédit fictif.
WALLET_SIMULATED=true

# KYC (V2-C03) : dépôts libres jusqu'à ce cumul (1000000 = 10 000,00 HTG) ; tout retrait exige un KYC validé
KYC_DEPOSIT_THRESHOLD_MINOR=1000000

# Paiements (V2-B01). Faux prestataire des tests et du développement : interdit en production.
PAYMENTS_FAKE_ENABLED=false
PAYMENTS_FAKE_SECRET=
# Webhook refusé au-delà de cet âge (s) ; dépôt non confirmé « expired » après ce délai (min)
PAYMENTS_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENTS_DEPOSIT_EXPIRY_MINUTES=30
# Montant d'un dépôt ouvert par le joueur, en unité mineure (10000 = 100,00 HTG ; 10000000 = 100 000,00 HTG)
PAYMENTS_DEPOSIT_MIN_MINOR=10000
PAYMENTS_DEPOSIT_MAX_MINOR=10000000
# Plop Plop (MonCash, NatCash, Kashpaw, carte). Identifiants de l'espace marchand, saisis sur le serveur seulement.
# Espace marchand : webhook_url = <site>/api/v1/payments/webhooks/plopplop ; lien_retour = <frontend>/wallet
PAYMENTS_PLOPPLOP_ENABLED=false
PAYMENTS_PLOPPLOP_BASE_URL=https://plopplop.solutionip.app/
PAYMENTS_PLOPPLOP_CLIENT_ID=
PAYMENTS_PLOPPLOP_CLIENT_SECRET=
# Le joueur choisit MonCash ou NatCash sur notre formulaire de dépôt (config/payments.php, providers.plopplop.methods).
# Retraits (V2-B03) : versés automatiquement par le prestataire (payments:payouts) depuis le portefeuille marchand.
PAYMENTS_WITHDRAWALS_ENABLED=false
PAYMENTS_WITHDRAWALS_PROVIDER=plopplop
# Identité validée (revue KYC, V2-C03) exigée avant un retrait : à ne couper qu'en développement
PAYMENTS_WITHDRAWALS_REQUIRE_KYC=true
# Bornes d'un retrait et plafond par joueur sur 24 h, en unité mineure (10000 = 100,00 HTG)
PAYMENTS_WITHDRAWAL_MIN_MINOR=10000
PAYMENTS_WITHDRAWAL_MAX_MINOR=5000000
PAYMENTS_WITHDRAWAL_DAILY_MAX_MINOR=10000000

# Âge minimum pour ouvrir un compte (décision D-01/D-09)
IDENTITY_MINIMUM_AGE=18
# Bêta fermée (V2-F07) : codes d'invitation exigés à l'inscription, séparés par des virgules ; vide = inscription ouverte
REGISTRATION_INVITE_CODES=

# Version des textes d'information acceptée à l'inscription (V2-E01) : égale à LEGAL_VERSION du frontend
IDENTITY_TERMS_VERSION=2026-11-02

# Monitoring et alertes (P9-02, docs/ops/monitoring-alertes.md) : vides = alertes seulement dans les logs.
MONITORING_LABEL="${APP_ENV}"
MONITORING_TELEGRAM_BOT_TOKEN=
MONITORING_TELEGRAM_CHAT_ID=
MONITORING_MAIL_TO=
MONITORING_HEARTBEAT_URL=
