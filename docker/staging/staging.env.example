# Modèle du fichier .env du serveur de Staging (P1-06). À copier en /opt/reyel16-staging/.env sur le serveur,
# compléter, puis protéger : chmod 600 .env. Ne JAMAIS committer le fichier rempli.
#
# Ce fichier sert deux fois : variables du docker-compose.yml (${…}) et environnement des conteneurs Laravel.
# Pas de « $ » dans les valeurs (docker compose l'interpréterait) : générer les mots de passe avec
#   openssl rand -hex 32

# --- Déploiement --------------------------------------------------------------------------------------------
REGISTRY_IMAGE=ghcr.io/plaisirrubly29-byte/reyel16paryaj
SITE_ADDRESS=staging.example.com
ACME_EMAIL=ops@example.com

# --- Application ------------------------------------------------------------------------------------------
APP_NAME="REYEL 16 PARYAJ (Staging)"
APP_ENV=staging
# php artisan key:generate --show (sur un poste de développement), à coller ici.
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# Logs vers la sortie des conteneurs : docker compose logs -f backend
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Base et Redis (conteneurs du docker-compose.yml, non exposés) -----------------------------------------
DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=reyel16
DB_USERNAME=reyel16
DB_PASSWORD=
REDIS_CLIENT=predis
REDIS_PORT=6379
REDIS_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# --- Frontend et API sur la même origine (Caddy) -----------------------------------------------------------
FRONTEND_URL=https://staging.example.com
SANCTUM_STATEFUL_DOMAINS=staging.example.com
CORS_ALLOWED_ORIGINS=https://staging.example.com
# Caddy transmet l'adresse réelle du client à php-fpm (FastCGI) : aucun proxy de confiance à déclarer.
TRUSTED_PROXIES=

MAIL_MAILER=log

# --- Données sportives (fournisseur fictif par défaut ; theodds exige une clé) -----------------------------
SPORTS_DATA_PROVIDER=fake
SPORTS_DATA_API_KEY=
