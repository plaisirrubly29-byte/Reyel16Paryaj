# Modèle du fichier .env.migration du serveur de Production (revue P8-02, F9 — V2-C07). À copier en
# /opt/reyel16-production/.env.migration, compléter, puis protéger : chmod 600 .env.migration.
# Ne JAMAIS committer le fichier rempli.
#
# Compte PROPRIÉTAIRE de la base (scripts/db/production-roles.sql) : migrations, rôles admin et sauvegardes, pendant
# le déploiement seulement. Ce fichier n'est lu que par production-deploy.sh (et, avec docker-compose.local-db.yml, par
# le conteneur PostgreSQL) : jamais par l'application en marche, qui se connecte avec DB_USERNAME de .env.
# Ces deux lignes ne doivent pas figurer dans .env (refusé par production-deploy.sh check).

DB_MIGRATION_USERNAME=reyel16_owner
# openssl rand -hex 32 ; différent de DB_PASSWORD.
DB_MIGRATION_PASSWORD=
