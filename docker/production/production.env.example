# Modèle du fichier .env du serveur de Production (V2-F01). À copier en /opt/reyel16-production/.env sur le serveur,
# compléter, puis protéger : chmod 600 .env. Ne JAMAIS committer le fichier rempli.
#
# Secrets PROPRES à la Production : aucune valeur reprise du Staging (APP_KEY, mots de passe, clés d'API).
# Ce fichier sert deux fois : variables du docker-compose.yml (${…}) et environnement des conteneurs Laravel.
# Pas de « $ » dans les valeurs (docker compose l'interpréterait) : générer les mots de passe avec
#   openssl rand -hex 32

# --- Déploiement --------------------------------------------------------------------------------------------
REGISTRY_IMAGE=ghcr.io/plaisirrubly29-byte/reyel16paryaj
SITE_ADDRESS=www.example.com
ACME_EMAIL=ops@example.com
# Sans base managée seulement (D-10 §7.2, fonds fictifs) : décommenter pour ajouter le conteneur PostgreSQL.
# COMPOSE_FILE=docker-compose.yml:docker-compose.local-db.yml

# --- Application ------------------------------------------------------------------------------------------
APP_NAME="REYEL 16 PARYAJ"
APP_ENV=production
# php artisan key:generate --show (sur un poste de développement), à coller ici. Jamais celle du Staging.
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.example.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Processus php-fpm au plus : environ 2 par vCPU (test de charge P8-03), donc 8 sur un serveur à 4 vCPU.
PHP_FPM_MAX_CHILDREN=8

# --- Base PostgreSQL managée (D-10) ------------------------------------------------------------------------
# Hôte PRIVÉ fourni par l'hébergeur (réseau privé du serveur), jamais l'adresse publique si un réseau privé existe.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=reyel16
# Compte de l'APPLICATION (scripts/db/production-roles.sql) : propriétaire de rien, sans droit de modifier, effacer ou
# vider les tables en ajout seul (revue P8-02, F9). Le compte propriétaire, pour les migrations, est dans un fichier à
# part, .env.migration (modèle : migration.env.example) : jamais ici, car ce fichier est lu par l'application.
DB_USERNAME=reyel16
DB_PASSWORD=
# Connexion chiffrée obligatoire vers la base managée. Avec docker-compose.local-db.yml : disable.
DB_SSLMODE=require
DB_PERSISTENT=true

# --- Redis (conteneur, non exposé) -------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_PORT=6379
REDIS_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
IDENTITY_PLAYER_SESSION_MAX_MINUTES=720
IDENTITY_ADMIN_SESSION_MAX_MINUTES=480
IDENTITY_ADMIN_MFA_IDLE_MINUTES=30
BETTING_MAX_BETS_PER_MINUTE=10
API_ACCOUNT_RATE_PER_MINUTE=120
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# --- Frontend et API sur la même origine (Caddy) -----------------------------------------------------------
FRONTEND_URL=https://www.example.com
SANCTUM_STATEFUL_DOMAINS=www.example.com
CORS_ALLOWED_ORIGINS=https://www.example.com
TRUSTED_PROXIES=

# Envoi réel des e-mails (réinitialisation de mot de passe, notifications) : fournisseur à choisir.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com

# --- Fournisseurs : jamais le fournisseur fictif en Production (refusé par production-deploy.sh) ------------
SPORTS_DATA_PROVIDER=theodds
SPORTS_DATA_API_KEY=
CATALOGUE_CACHE_SECONDS=10

# Borlette et jeux virtuels : coupés tant que D-12 et D-11 ne sont pas validées.
LOTTERY_ENABLED=false
